{
  "name": "@trebco/treb",
  "version": "41.0.1",
  "license": "LGPL-3.0-or-later",
  "homepage": "https://treb.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/trebco/treb.git"
  },
  "main": "dist/treb-spreadsheet.mjs",
  "types": "dist/treb.d.ts",
  "type": "module",
  "imports": {
    "#treb-base-types": {
      "treb-source": "./treb-base-types/src/index.ts",
      "types": "./build/treb-base-types/src/index.d.ts",
      "default": "./treb-base-types/src/index.ts"
    },
    "#treb-base-types/*": {
      "treb-source": "./treb-base-types/*.ts",
      "types": "./build/treb-base-types/*.d.ts",
      "default": "./treb-base-types/*.ts"
    },
    "#treb-calculator": {
      "treb-source": "./treb-calculator/src/index.ts",
      "types": "./build/treb-calculator/src/index.d.ts",
      "default": "./treb-calculator/src/index.ts"
    },
    "#treb-calculator/*": {
      "treb-source": "./treb-calculator/*.ts",
      "types": "./build/treb-calculator/*.d.ts",
      "default": "./treb-calculator/*.ts"
    },
    "#treb-charts": {
      "treb-source": "./treb-charts/src/index.ts",
      "types": "./build/treb-charts/src/index.d.ts",
      "default": "./treb-charts/src/index.ts"
    },
    "#treb-charts/*": {
      "treb-source": "./treb-charts/*.ts",
      "types": "./build/treb-charts/*.d.ts",
      "default": "./treb-charts/*.ts"
    },
    "#treb-data-model": {
      "treb-source": "./treb-data-model/src/index.ts",
      "types": "./build/treb-data-model/src/index.d.ts",
      "default": "./treb-data-model/src/index.ts"
    },
    "#treb-data-model/*": {
      "treb-source": "./treb-data-model/*.ts",
      "types": "./build/treb-data-model/*.d.ts",
      "default": "./treb-data-model/*.ts"
    },
    "#treb-export": {
      "treb-source": "./treb-export/src/index.ts",
      "types": "./build/treb-export/src/index.d.ts",
      "default": "./treb-export/src/index.ts"
    },
    "#treb-export/*": {
      "treb-source": "./treb-export/*.ts",
      "types": "./build/treb-export/*.d.ts",
      "default": "./treb-export/*.ts"
    },
    "#treb-format": {
      "treb-source": "./treb-format/src/index.ts",
      "types": "./build/treb-format/src/index.d.ts",
      "default": "./treb-format/src/index.ts"
    },
    "#treb-format/*": {
      "treb-source": "./treb-format/*.ts",
      "types": "./build/treb-format/*.d.ts",
      "default": "./treb-format/*.ts"
    },
    "#treb-grid": {
      "treb-source": "./treb-grid/src/index.ts",
      "types": "./build/treb-grid/src/index.d.ts",
      "default": "./treb-grid/src/index.ts"
    },
    "#treb-grid/*": {
      "treb-source": "./treb-grid/*.ts",
      "types": "./build/treb-grid/*.d.ts",
      "default": "./treb-grid/*.ts"
    },
    "#treb-parser": {
      "treb-source": "./treb-parser/src/index.ts",
      "types": "./build/treb-parser/src/index.d.ts",
      "default": "./treb-parser/src/index.ts"
    },
    "#treb-parser/*": {
      "treb-source": "./treb-parser/*.ts",
      "types": "./build/treb-parser/*.d.ts",
      "default": "./treb-parser/*.ts"
    },
    "#treb-utils": {
      "treb-source": "./treb-utils/src/index.ts",
      "types": "./build/treb-utils/src/index.d.ts",
      "default": "./treb-utils/src/index.ts"
    },
    "#treb-utils/*": {
      "treb-source": "./treb-utils/*.ts",
      "types": "./build/treb-utils/*.d.ts",
      "default": "./treb-utils/*.ts"
    },
    "#treb-embed": {
      "treb-source": "./treb-embed/src/index.ts",
      "types": "./build/treb-embed/src/index.d.ts",
      "default": "./treb-embed/src/index.ts"
    },
    "#treb-embed/*": {
      "treb-source": "./treb-embed/*.ts",
      "types": "./build/treb-embed/*.d.ts",
      "default": "./treb-embed/*.ts"
    },
    "#ooxml-types": {
      "treb-source": "./ooxml-types/src/types/index.ts",
      "types": "./build/ooxml-types/src/types/index.d.ts",
      "default": "./ooxml-types/src/types/index.ts"
    },
    "#ooxml-types/*": {
      "treb-source": "./ooxml-types/*.ts",
      "types": "./build/ooxml-types/*.d.ts",
      "default": "./ooxml-types/*.ts"
    },
    "#extended-function-lib": {
      "treb-source": "./extended-function-lib/src/index.ts",
      "types": "./build/extended-function-lib/src/index.d.ts",
      "default": "./extended-function-lib/src/index.ts"
    },
    "#extended-function-lib/*": {
      "treb-source": "./extended-function-lib/*.ts",
      "types": "./build/extended-function-lib/*.d.ts",
      "default": "./extended-function-lib/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/treb.d.ts",
      "import": "./dist/treb-spreadsheet.mjs",
      "browser": "./dist/treb-spreadsheet.mjs"
    },
    "./treb-grid": {
      "types": "./build/treb-grid/src/index.d.ts",
      "import": "./treb-grid/src/index.ts"
    },
    "./treb-grid/*": {
      "types": "./build/treb-grid/*.d.ts",
      "import": "./treb-grid/*.ts"
    },
    "./treb-charts": {
      "types": "./build/treb-charts/src/index.d.ts",
      "import": "./treb-charts/src/index.ts"
    },
    "./treb-charts/*": {
      "types": "./build/treb-charts/*.d.ts",
      "import": "./treb-charts/*.ts"
    },
    "./treb-embed": {
      "types": "./build/treb-embed/src/index.d.ts",
      "import": "./treb-embed/src/index.ts"
    },
    "./treb-embed/*": {
      "types": "./build/treb-embed/*.d.ts",
      "import": "./treb-embed/*.ts"
    },
    "./treb-embed/*.html": {
      "import": "./treb-embed/*.html"
    },
    "./treb-calculator": {
      "types": "./build/treb-calculator/src/index.d.ts",
      "import": "./treb-calculator/src/index.ts"
    },
    "./treb-calculator/*": {
      "types": "./build/treb-calculator/*.d.ts",
      "import": "./treb-calculator/*.ts"
    },
    "./treb-format": {
      "types": "./build/treb-format/src/index.d.ts",
      "import": "./treb-format/src/index.ts"
    },
    "./treb-parser": {
      "types": "./build/treb-parser/src/index.d.ts",
      "import": "./treb-parser/src/index.ts"
    },
    "./treb-utils": {
      "types": "./build/treb-utils/src/index.d.ts",
      "import": "./treb-utils/src/index.ts"
    },
    "./treb-data-model": {
      "types": "./build/treb-data-model/src/index.d.ts",
      "import": "./treb-data-model/src/index.ts"
    },
    "./treb-base-types": {
      "types": "./build/treb-base-types/src/index.d.ts",
      "import": "./treb-base-types/src/index.ts"
    },
    "./treb-base-types/*": {
      "types": "./build/treb-base-types/*.d.ts",
      "import": "./treb-base-types/*.ts"
    },
    "./ooxml-types": {
      "types": "./build/ooxml-types/src/types/index.d.ts",
      "import": "./ooxml-types/src/types/index.ts"
    },
    "./extended-function-lib": {
      "types": "./build/extended-function-lib/src/index.d.ts",
      "import": "./extended-function-lib/src/index.ts"
    },
    "./esbuild-utils.mjs": "./esbuild-utils.mjs",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/html-minifier": "^4.0.6",
    "@types/node": "^25.5.0",
    "@typescript/typescript6": "^6.0.2",
    "esbuild": "^0.28.0",
    "fast-xml-parser": "^5.3.2",
    "fflate": "^0.8.3",
    "html-minifier-terser": "^7.2.0",
    "oxlint": "^1.94.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node esbuild-composite.mjs",
    "alt": "node esbuild-composite.mjs --alt",
    "dev": "node esbuild-composite.mjs --dev",
    "clean": "rm -fr build dist",
    "watch": "node --watch esbuild-composite.mjs --watch --dev",
    "watch-production": "node --watch esbuild-composite.mjs --watch",
    "tsc": "tsc",
    "rebuild-tsc": "rm -rf build && tsc",
    "watch-tsc": "tsc -w",
    "watch-api": "tsx --watch api-generator/api-generator.ts --config api-config.json",
    "generate-api": "tsx api-generator/api-generator.ts --config api-config.json",
    "release": "npm run clean && npm run rebuild-tsc && npm run build && npm run generate-api",
    "coverage-test": "npm run build && cd coverage-test && bun run main.ts",
    "lint:sonar": "eslint -c eslint.sonar.config.js \"treb-*/src/**/*.ts\"",
    "lint:sonar-dist": "eslint -c eslint.sonar.config.js \"dist/**/*.mjs\""
  }
}
