{
  "compilerOptions": {
    "declaration": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["treb-source"],
    "strict": true,
    "outDir": "./build",
    "rootDir": ".",
    "experimentalDecorators": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "noEmitHelpers": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "lib": ["dom", "esnext", "dom.iterable"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "treb-*/src/**/*.ts",
    "extended-function-lib/src/**/*.ts",
    "ooxml-types/src/**/*.ts"
  ],
  "exclude": [
    "treb-embed/src/API/api-v1.ts",
    "treb-embed/src/API/api-utils.ts",
    "treb-embed/src/index-modern-mc.ts",
    "treb-embed/src/index-module-mc.ts",
    "treb-export/src/export-worker/index-legacy.ts",
    "**/*.test.ts"
  ]
}
